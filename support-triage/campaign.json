{
  "slug": "synthetic-support-triage",
  "name": "Support triage: synthetic pilot",
  "objective": "Test a support-message labelling workflow using ten fictional messages, scripted answers and scripted review decisions.",
  "purpose": "Demonstration only. No customer records or real participant judgements are collected in this example.",
  "language": "en",
  "instructions": "Choose the topic of the message. These messages are fictional. Skip any item you cannot judge from the available context.",
  "brief": "Billing: charges, refunds, invoices or subscription payments. Technical problem: an existing feature fails to work. Feature request: a capability that does not exist yet. Other: a request outside those topics. For mixed topics, use the explicit requested action; skip if no primary action can be identified.",
  "collectionPolicy": {
    "roundSize": 10,
    "ordering": "sequential",
    "allowSkip": true,
    "maxSubmissionsPerContributor": 0,
    "maxSubmissionsPerScenario": 0,
    "askDeclaredAssistance": true,
    "askContributorName": false,
    "askContributorEmail": false
  },
